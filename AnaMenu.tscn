[sub_resource type="GDScript" id="GDScript_esw1c"]
script/source = "extends Control

@export_group(\"Menu Nodes\")
@export var logo: Control
@export var buttons_container: Control
@export var profile_panel: Control

@export_group(\"Timing\")
@export_range(0.1, 2.0, 0.05) var logo_duration := 0.55
@export_range(0.1, 2.0, 0.05) var panel_duration := 0.60
@export_range(0.1, 1.0, 0.05) var button_duration := 0.32
@export_range(0.0, 0.3, 0.01) var button_delay := 0.07

@export_group(\"Movement\")
@export var logo_offset := Vector2(0.0, -18.0)
@export var buttons_offset := Vector2(-28.0, 0.0)
@export var panel_offset := Vector2(42.0, 0.0)
@export_range(0.85, 1.0, 0.01) var button_start_scale := 0.96

var _buttons: Array[BaseButton] = []
var _previous_mouse_filters: Dictionary = {}
var _previous_focus_modes: Dictionary = {}


func _ready() -> void:
	if not _nodes_are_ready():
		return

	_collect_buttons(buttons_container)

	# Containers may reset child scale during their first layout pass.
	await get_tree().process_frame
	await _play_intro()


func _nodes_are_ready() -> bool:
	if logo == null:
		push_warning(\"Menu intro: Logo node is not assigned.\")
		return false
	if buttons_container == null:
		push_warning(\"Menu intro: Buttons Container node is not assigned.\")
		return false
	if profile_panel == null:
		push_warning(\"Menu intro: Profile Panel node is not assigned.\")
		return false
	return true


func _collect_buttons(node: Node) -> void:
	for child in node.get_children():
		if child is BaseButton:
			_buttons.append(child)
		else:
			_collect_buttons(child)


func _play_intro() -> void:
	var logo_final_position := logo.position
	var buttons_final_position := buttons_container.position
	var panel_final_position := profile_panel.position

	logo.position = logo_final_position + logo_offset
	logo.modulate.a = 0.0

	buttons_container.position = buttons_final_position + buttons_offset

	profile_panel.position = panel_final_position + panel_offset
	profile_panel.modulate.a = 0.0

	for button in _buttons:
		_previous_mouse_filters[button] = button.mouse_filter
		_previous_focus_modes[button] = button.focus_mode
		button.mouse_filter = Control.MOUSE_FILTER_IGNORE
		button.focus_mode = Control.FOCUS_NONE
		button.pivot_offset = button.size * 0.5
		button.scale = Vector2.ONE * button_start_scale
		button.modulate.a = 0.0

	var intro := create_tween()
	intro.set_parallel(true)
	intro.set_trans(Tween.TRANS_CUBIC)
	intro.set_ease(Tween.EASE_OUT)

	intro.tween_property(
		logo,
		\"position\",
		logo_final_position,
		logo_duration
	).set_delay(0.05)
	intro.tween_property(
		logo,
		\"modulate:a\",
		1.0,
		logo_duration * 0.80
	).set_delay(0.05)

	intro.tween_property(
		buttons_container,
		\"position\",
		buttons_final_position,
		panel_duration
	).set_delay(0.16)

	for index in range(_buttons.size()):
		var button := _buttons[index]
		var delay := 0.20 + index * button_delay

		intro.tween_property(
			button,
			\"modulate:a\",
			1.0,
			button_duration
		).set_delay(delay)
		intro.tween_property(
			button,
			\"scale\",
			Vector2.ONE,
			button_duration
		).set_delay(delay)

	intro.tween_property(
		profile_panel,
		\"position\",
		panel_final_position,
		panel_duration
	).set_delay(0.12)
	intro.tween_property(
		profile_panel,
		\"modulate:a\",
		1.0,
		panel_duration * 0.85
	).set_delay(0.12)

	await intro.finished

	for button in _buttons:
		if is_instance_valid(button):
			button.mouse_filter = _previous_mouse_filters.get(
				button,
				Control.MOUSE_FILTER_STOP
			)
			button.focus_mode = _previous_focus_modes.get(
				button,
				Control.FOCUS_ALL
			)
"

