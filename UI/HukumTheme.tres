HukumCompact/styles/hover = SubResource("compact_hover")
HukumCompact/styles/pressed = SubResource("compact_selected")
HukumCompact/styles/hover_pressed = SubResource("compact_hover_pressed")
HukumCompact/styles/disabled = SubResource("compact_disabled")
HukumCompact/font_sizes/font_size = 14
PanelContainer/styles/panel = SubResource("panel")
