Button/colors/font_disabled_color = Color(0.55, 0.53, 0.46, 1)
Button/colors/font_focus_color = Color(1, 0.96, 0.83, 1)
Button/constants/outline_size = 2
Button/colors/font_outline_color = Color(0, 0, 0, 0.8)
Button/styles/focus = SubResource("focus")
